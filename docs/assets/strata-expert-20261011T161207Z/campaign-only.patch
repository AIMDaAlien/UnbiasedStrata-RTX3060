+  if r['kind']=='resource':resources[(path.name,r['layer'],r['class'],r['phase'])]=r
+  if r['kind']=='timing':samples[(r['layer'],r['class'],r['phase'],r['pair'])][r['variant']]=r['ms']
+ for (layer,cl,phase,pair),ms in samples.items():
